# ==========================================
# EKO RESTAURANT - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Sessions (Stage 4)
SESSION_SECRET=your_super_secret_session_key_here

# Database Configuration - MySQL (Stage 2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=eko_restaurant
DATABASE_URL=mysql://root:your_db_password@localhost:3306/eko_restaurant

# Admin Credentials Defaults (Stage 4)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# Email / SMTP Notifications (Stage 13)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mugishamp7@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=mugishamp7@gmail.com

# Payment Provider Configuration (Stage 10)
# Rwanda MTN MoMo, Airtel Money, Cards
PAYMENT_PROVIDER=flutterwave
PAYMENT_PUBLIC_KEY=your_payment_public_key
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_ENCRYPTION_KEY=your_payment_encryption_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Google Maps API (Stage 5 / Stage 26)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloud Storage Configuration for Images (Stage 10 / Stage 13)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Studio injected variables
GEMINI_API_KEY=
